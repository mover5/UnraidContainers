# =============================================================================
# Caddy Reverse Proxy — initial configuration
# =============================================================================
#
# This file is the seed configuration on first start. Once you've added
# routes via the web UI on port 9999, the UI takes over and rewrites this
# file. A UI-managed file always starts with:
#
#     # managed-by-ui
#
# If you'd rather keep editing this file by hand, just don't use the UI.
# =============================================================================

{
	acme_dns cloudflare {env.CF_API_TOKEN}
	admin 127.0.0.1:2019
	log {
		output file /var/log/caddy/caddy.log
		format console
	}
}

