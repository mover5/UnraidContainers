      "extra_directives": ""
    },
    {
      "id": "fixture-strict",
      "subdomain": "strict.example.com",
      "upstream": "192.168.1.100:9000",
      "enabled": true,
      "description": "Has extra directives",
      "extra_directives": "header X-Frame-Options DENY\nencode gzip"
    }
  ],
  "certs": [
    { "domain": "cleanrr.example.com", "issuer": "Let's Encrypt", "not_after_days": 60, "status": "ok" },
